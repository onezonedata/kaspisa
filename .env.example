# Скопируйте в .env и заполните. Файл .env в git не попадает.
KASPISA_DATABASE_URL=postgresql+asyncpg://kaspisa:kaspisa@localhost:5432/kaspisa
KASPISA_REDIS_URL=redis://localhost:6379/0
# Режим «без записи»: бот считает цены, но не отправляет их в Kaspi.
KASPISA_DRY_RUN=true
# Ключ шифрования доступов продавцов. Формат: <id>:<base64 от 32 байт>, id от 1 до 255.
# Создать (из backend/):
#   uv run python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# Без ключа доступы не шифруются и не читаются. Потерян ключ — все магазины подключаются заново.
KASPISA_ENCRYPTION_KEY=
# Прежние ключи, только для расшифровки: тот же формат, через запятую. Нужны на время ротации.
KASPISA_ENCRYPTION_OLD_KEYS=
# Порты Postgres и Redis для `make up` и тестов, если 5432 или 6379 заняты.
# При смене порта поправьте и адреса KASPISA_DATABASE_URL / KASPISA_REDIS_URL выше.
# KASPISA_PG_PORT=5433
# KASPISA_REDIS_PORT=6380
# Флаг Secure у cookie сессии API. Умолчание (если переменной нет) - true: cookie уходит только по https.
# Для разработки по http (например, Safari на http://localhost) поставьте false; в бою - true.
KASPISA_COOKIE_SECURE=true
